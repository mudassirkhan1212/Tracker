<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Refrence Tracker</title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
  />

  <link rel="stylesheet" href="/css/style.css" />

<script async src="https://www.googletagmanager.com/gtag/js?id=G-QJFHRYJQ4T"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-QJFHRYJQ4T');
</script>



</head>
<body>

  <header class="app-header d-flex align-items-center justify-content-between px-4 py-3">
    <h1 class="h4 mb-0">Refrence Tracker</h1>
    
  </header>

  <main class="container py-4">
<div class="text-center mb-4">
    <button id="toggleFormBtn" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#formModal">
      <i class="bi bi-plus-lg me-1"></i> Add Post
    </button>
</div>


    <div class="modal fade" id="formModal" tabindex="-1" aria-labelledby="formModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" id="formWrapper">
          <div class="modal-header">
            <h5 class="modal-title" id="formModalLabel">Post</h5>
            <button type="button" class="btn-close" id="cancelFormBtn" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <form id="postForm">
              <div class="row g-3">

                <div class="col-md-6">
                  <label for="companyName" class="form-label">Company Name</label>
                  <input
                    type="text"
                    class="form-control"
                    id="companyName"
                    name="companyName"
                    maxlength="50"
                    required
                  />
                </div>

                <div class="col-md-6">
                  <label for="departmentName" class="form-label">Department Name</label>
                  <input
                    type="text"
                    class="form-control"
                    id="departmentName"
                    name="departmentName"
                    maxlength="50"
                    required
                  />
                </div>

                <div class="col-md-6">
                  <label for="refrenceEmployee" class="form-label">Reference Employee</label>
                  <input
                    type="number"
                    class="form-control"
                    id="refrenceEmployee"
                    name="refrenceEmployee"
                    required
                  />
                </div>

                <div class="col-md-6">
                  <label for="totalEmployee" class="form-label">Total Employee</label>
                  <input
                    type="number"
                    class="form-control"
                    id="totalEmployee"
                    name="totalEmployee"
                    required
                  />
                </div>

              </div>

              <div class="mt-3 d-flex gap-2">
                <button type="submit" class="btn btn-success">Save Post</button>
                <button type="button" id="cancelFormBtn2" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                  Cancel
                </button>
              </div>

              <div id="formError" class="text-danger small mt-2 d-none"></div>
            </form>
          </div>
        </div>
      </div>
    </div>

    <div id="postsContainer" class="row g-3">
      <% if (posts && posts.length > 0) { %>
        <% posts.forEach(function(post) { %>
          <div class="col-md-6 col-lg-4">
            <div class="card post-card h-100">
              <div class="card-body">
                <div class="post-row">
                  <span class="post-key">Company</span>
                  <span class="post-value"><%= post.companyName %></span>
                </div>
                <div class="post-row">
                  <span class="post-key">Department</span>
                  <span class="post-value"><%= post.departmentName %></span>
                </div>
                <div class="post-row highlight-row">
                  <span class="post-key">Reference Employee</span>
                  <span class="post-value"><%= post.refrenceEmployee %></span>
                </div>
                <div class="post-row">
                  <span class="post-key">Total Employee</span>
                  <span class="post-value"><%= post.totalEmployee %></span>
                </div>
              </div>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <p id="noPostsMsg" class="text-muted">No posts yet. Click "Add Post" to create one.</p>
      <% } %>
    </div>

  </main>

  <template id="postCardTemplate">
    <div class="col-md-6 col-lg-4">
      <div class="card post-card h-100">
        <div class="card-body">
          <div class="post-row">
            <span class="post-key">Company </span>
            <span class="post-value" data-field="companyName"></span>
          </div>
          <div class="post-row">
            <span class="post-key">Department</span>
            <span class="post-value" data-field="departmentName"></span>
          </div>
          <div class="post-row highlight-row">
            <span class="post-key">Reference Employee</span>
            <span class="post-value" data-field="refrenceEmployee"></span>
          </div>
          <div class="post-row">
            <span class="post-key">Total Employee</span>
            <span class="post-value" data-field="totalEmployee"></span>
          </div>
        </div>
      </div>
    </div>
  </template>




  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/index.js"></script>
</body>
</html>
